// Crash test: all operators in one expression
fn test() -> Int {
    let a = 1 + 2 - 3 * 4 / 5 % 6
    let b = a == 10 && a != 5 || a > 3 && a < 100 && a >= 1 && a <= 50
    let c = !b
    let d = (a + 5) * (a - 3) / (a + 1) % 7
    let e = a == b || c && d != 0 || a > d && b < c
    return a + d
}
