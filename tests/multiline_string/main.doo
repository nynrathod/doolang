// EXPECT: SELECT id, name
// EXPECT: FROM users
// EXPECT: WHERE active = true;
// EXPECT: 
// EXPECT: --- Test 2: Interpolation ---
// EXPECT: Hello Alice,
// EXPECT: Welcome to Doo!
// EXPECT: 
