// EXPECT: FROM doolang/runtime:latest
// EXPECT: WORKDIR /app
// EXPECT: COPY . .
// EXPECT: EXPOSE 8080
// EXPECT: CMD ["./output"]
// EXPECT: 
// EXPECT: --- Test 4: Empty String ---
// EXPECT: Empty: ''
// EXPECT: 
