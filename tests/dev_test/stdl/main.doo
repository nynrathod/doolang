import std::Array::{Unique, Range, Sum, MinArr, MaxArr};
import std::Math::{Abs, Pow, Sqrt, Min, Max, Floor, Ceil, Round};

fn main() {
    print("Abs(-42): ");
    print(Abs(-42));

    print("Abs(42): ");
    print(Abs(42));

    print("Pow(2, 8): ");
    print(Pow(2, 8));

    print("Pow(3, 3): ");
    print(Pow(3, 3));

    print("Sqrt(49): ");
    print(Sqrt(49));

    print("Sqrt(16): ");
    print(Sqrt(16));

    print("Min(3, 7): ");
    print(Min(3, 7));

    print("Min(10, 5): ");
    print(Min(10, 5));

    print("Max(3, 7): ");
    print(Max(3, 7));

    print("Max(100, 50): ");
    print(Max(100, 50));

    print("Floor(3.7): ");
    print(Floor(3.7));

    print("Floor(-3.7): ");
    print(Floor(-3.7));

    print("Ceil(3.2): ");
    print(Ceil(3.2));

    print("Ceil(-3.2): ");
    print(Ceil(-3.2));

    print("Round(3.5): ");
    print(Round(3.5));

    print("Round(3.49): ");
    print(Round(3.49));

    print("Round(-3.5): ");
    print(Round(-3.5));

    print("Round(-3.51): ");
    print(Round(-3.51));

    print("");
    print("✓ Math functions PASS");
    print("");

    print("Unique([1,2,2,3,3,3]): ");
    print(Unique([1, 2, 2, 3, 3, 3]));

    print("Unique([5,5,5,5]): ");
    print(Unique([5, 5, 5, 5]));

    print("Unique([1,2,3]): ");
    print(Unique([1, 2, 3]));

    print("Range(3, 7): ");
    print(Range(3, 7));

    print("Range(0, 5): ");
    print(Range(0, 5));

    print("Range(10, 15): ");
    print(Range(10, 15));

    print("Sum([1,2,3,4,5]): ");
    print(Sum([1, 2, 3, 4, 5]));

    print("Sum([10,20,30]): ");
    print(Sum([10, 20, 30]));

    print("MinArr([5,2,8,1,9]): ");
    print(MinArr([5, 2, 8, 1, 9]));

    print("MinArr([100,50,75]): ");
    print(MinArr([100, 50, 75]));

    print("MaxArr([5,2,8,1,9]): ");
    print(MaxArr([5, 2, 8, 1, 9]));

    print("MaxArr([100,50,75]): ");
    print(MaxArr([100, 50, 75]));

    print("");
    print("✓ Array functions PASS");
    print("");
}

// expect: Abs(-42): 42
// expect: Abs(42): 42
// expect: Pow(2, 8): 256
// expect: Pow(3, 3): 27
// expect: Sqrt(49): 7
// expect: Sqrt(16): 4
// expect: Min(3, 7): 3
// expect: Min(10, 5): 5
// expect: Max(3, 7): 7
// expect: Max(100, 50): 100
// expect: Floor(3.7): 3
// expect: Floor(-3.7): -4
// expect: Ceil(3.2): 4
// expect: Ceil(-3.2): -3
// expect: Round(3.5): 4
// expect: Round(3.49): 3
// expect: Round(-3.5): -4
// expect: Round(-3.51): -4
// expect:
// expect: ✓ Math functions PASS
// expect:
// expect: Unique([1,2,2,3,3,3]): [1, 2, 3]
// expect: Unique([5,5,5,5]): [5]
// expect: Unique([1,2,3]): [1, 2, 3]
// expect: Range(3, 7): [3, 4, 5, 6]
// expect: Range(0, 5): [0, 1, 2, 3, 4]
// expect: Range(10, 15): [10, 11, 12, 13, 14]
// expect: Sum([1,2,3,4,5]): 15
// expect: Sum([10,20,30]): 60
// expect: MinArr([5,2,8,1,9]): 1
// expect: MinArr([100,50,75]): 50
// expect: MaxArr([5,2,8,1,9]): 9
// expect: MaxArr([100,50,75]): 100
// expect:
// expect: ✓ Array functions PASS
// expect:
