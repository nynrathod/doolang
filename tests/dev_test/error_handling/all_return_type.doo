// Comprehensive error handling test for all supported types

// Test structs for error types
struct IntError {
    code: Int,
    reason: Str
}

struct FloatError {
    value: Float,
    message: Str
}

struct BoolError {
    flag: Bool,
    info: Str
}

struct StrError {
    text: Str,
    context: Str
}

// ============================================
// Test functions returning different error types
// ============================================

// Int error type
fn TestIntError(x: Int) -> Str ! Int {
    if x < 0 {
        Err -1;
    }
    Ok "success";
}

// Float error type
fn TestFloatError(x: Float) -> Str ! Float {
    if x < 0.0 {
        Err -99.9;
    }
    Ok "success";
}

// Bool error type
fn TestBoolError(x: Bool) -> Str ! Bool {
    if x {
        Err true;
    }
    Ok "success";
}

// Str error type
fn TestStrError(x: Int) -> Int ! Str {
    if x < 0 {
        Err "string error occurred";
    }
    Ok x * 2;
}

// Struct error types
fn TestStructIntError(x: Int) -> Str ! IntError {
    if x < 0 {
        Err IntError { code: 100, reason: "negative value" };
    }
    Ok "success";
}

fn TestStructFloatError(x: Float) -> Str ! FloatError {
    if x < 0.0 {
        Err FloatError { value: x, message: "negative float" };
    }
    Ok "success";
}

fn TestStructBoolError(x: Bool) -> Str ! BoolError {
    if x {
        Err BoolError { flag: x, info: "flag was true" };
    }
    Ok "success";
}

fn TestStructStrError(x: Int) -> Int ! StrError {
    if x < 0 {
        Err StrError { text: "error text", context: "negative number" };
    }
    Ok x;
}

// Array error type
fn TestArrayIntError(x: Int) -> Str ! [Int] {
    if x < 0 {
        Err [1, 2, 3];
    }
    Ok "success";
}

fn TestArrayFloatError(x: Float) -> Str ! [Float] {
    if x < 0.0 {
        Err [1.1, 2.2, 3.3];
    }
    Ok "success";
}

fn TestArrayBoolError(x: Bool) -> Str ! [Bool] {
    if x {
        Err [true, false, true];
    }
    Ok "success";
}

fn TestArrayStrError(x: Int) -> Int ! [Str] {
    if x < 0 {
        Err ["error1", "error2", "error3"];
    }
    Ok x;
}

// Map error types
fn TestMapStrIntError(x: Int) -> Str ! {Str: Int} {
    if x < 0 {
        Err { "code": 500, "status": 1 };
    }
    Ok "success";
}

fn TestMapStrFloatError(x: Float) -> Str ! {Str: Float} {
    if x < 0.0 {
        Err { "value": 1.5, "threshold": 0.0 };
    }
    Ok "success";
}

fn TestMapStrBoolError(x: Bool) -> Str ! {Str: Bool} {
    if x {
        Err { "enabled": true, "valid": false };
    }
    Ok "success";
}

fn TestMapStrStrError(x: Int) -> Int ! {Str: Str} {
    if x < 0 {
        Err { "error": "occurred", "type": "negative" };
    }
    Ok x;
}

fn TestMapIntIntError(x: Int) -> Str ! {Int: Int} {
    if x < 0 {
        Err { 1: 100, 2: 200 };
    }
    Ok "success";
}

fn TestMapIntFloatError(x: Float) -> Str ! {Int: Float} {
    if x < 0.0 {
        Err { 1: 1.5, 2: 2.5 };
    }
    Ok "success";
}

fn TestMapIntBoolError(x: Bool) -> Str ! {Int: Bool} {
    if x {
        Err { 0: false, 1: true };
    }
    Ok "success";
}

fn TestMapIntStrError(x: Int) -> Int ! {Int: Str} {
    if x < 0 {
        Err { 1: "first", 2: "second" };
    }
    Ok x;
}

// Float key maps
fn TestMapFloatIntError(x: Int) -> Str ! {Float: Int} {
    if x < 0 {
        Err { 1.5: 100, 2.5: 200 };
    }
    Ok "success";
}

fn TestMapFloatFloatError(x: Float) -> Str ! {Float: Float} {
    if x < 0.0 {
        Err { 1.1: 1.5, 2.2: 2.5 };
    }
    Ok "success";
}

fn TestMapFloatBoolError(x: Bool) -> Str ! {Float: Bool} {
    if x {
        Err { 0.0: false, 1.0: true };
    }
    Ok "success";
}

fn TestMapFloatStrError(x: Int) -> Int ! {Float: Str} {
    if x < 0 {
        Err { 1.0: "first", 2.0: "second" };
    }
    Ok x;
}

// Bool key maps
fn TestMapBoolIntError(x: Int) -> Str ! {Bool: Int} {
    if x < 0 {
        Err { true: 100, false: 200 };
    }
    Ok "success";
}

fn TestMapBoolFloatError(x: Float) -> Str ! {Bool: Float} {
    if x < 0.0 {
        Err { true: 1.5, false: 2.5 };
    }
    Ok "success";
}

fn TestMapBoolBoolError(x: Bool) -> Str ! {Bool: Bool} {
    if x {
        Err { true: false, false: true };
    }
    Ok "success";
}

fn TestMapBoolStrError(x: Int) -> Int ! {Bool: Str} {
    if x < 0 {
        Err { true: "yes", false: "no" };
    }
    Ok x;
}

// ============================================
// Main test runner
// ============================================

fn main() {
    print("=== Comprehensive Error Handling Test ===\n");

    // Test 1: Int error
    print("Test 1: Int error (Ok case)");
    let r1 , e1 = TestIntError(5);
    if e1 != nil {
        print("  Error:", e1);
    } else {
        print("  Result:", r1);
    }

    print("Test 1b: Int error (Err case)");
    let r1b , e1b = TestIntError(-5);
    if e1b != nil {
        print("  Error:", e1b);
    } else {
        print("  Result:", r1b);
    }

    // Test 2: Float error
    print("\nTest 2: Float error (Ok case)");
    let r2 , e2 = TestFloatError(5.5);
    if e2 != nil {
        print("  Error:", e2);
    } else {
        print("  Result:", r2);
    }

    print("Test 2b: Float error (Err case)");
    let r2b , e2b = TestFloatError(-5.5);
    if e2b != nil {
        print("  Error:", e2b);
    } else {
        print("  Result:", r2b);
    }

    // Test 3: Bool error
    print("\nTest 3: Bool error (Ok case)");
    let r3 , e3 = TestBoolError(false);
    if e3 != nil {
        print("  Error:", e3);
    } else {
        print("  Result:", r3);
    }

    print("Test 3b: Bool error (Err case)");
    let r3b , e3b = TestBoolError(true);
    if e3b != nil {
        print("  Error:", e3b);
    } else {
        print("  Result:", r3b);
    }

    // Test 4: Str error
    print("\nTest 4: Str error (Ok case)");
    let r4 , e4 = TestStrError(5);
    if e4 != nil {
        print("  Error:", e4);
    } else {
        print("  Result:", r4);
    }

    print("Test 4b: Str error (Err case)");
    let r4b , e4b = TestStrError(-5);
    if e4b != nil {
        print("  Error:", e4b);
    } else {
        print("  Result:", r4b);
    }

    // Test 5: Struct with Int field
    print("\nTest 5: IntError struct (Ok case)");
    let r5 , e5 = TestStructIntError(5);
    if e5 != nil {
        print("  Error code:", e5.code, ", reason:", e5.reason);
    } else {
        print("  Result:", r5);
    }

    print("Test 5b: IntError struct (Err case)");
    let r5b , e5b = TestStructIntError(-5);
    if e5b != nil {
        print("  Error code:", e5b.code, ", reason:", e5b.reason);
    } else {
        print("  Result:", r5b);
    }

    // Test 6: Struct with Float field
    print("\nTest 6: FloatError struct (Ok case)");
    let r6 , e6 = TestStructFloatError(5.5);
    if e6 != nil {
        print("  Error value:", e6.value, ", message:", e6.message);
    } else {
        print("  Result:", r6);
    }

    print("Test 6b: FloatError struct (Err case)");
    let r6b , e6b = TestStructFloatError(-5.5);
    if e6b != nil {
        print("  Error value:", e6b.value, ", message:", e6b.message);
    } else {
        print("  Result:", r6b);
    }

    // Test 7: Struct with Bool field
    print("\nTest 7: BoolError struct (Ok case)");
    let r7 , e7 = TestStructBoolError(false);
    if e7 != nil {
        print("  Error flag:", e7.flag, ", info:", e7.info);
    } else {
        print("  Result:", r7);
    }

    print("Test 7b: BoolError struct (Err case)");
    let r7b , e7b = TestStructBoolError(true);
    if e7b != nil {
        print("  Error flag:", e7b.flag, ", info:", e7b.info);
    } else {
        print("  Result:", r7b);
    }

    // Test 8: Struct with Str field
    print("\nTest 8: StrError struct (Ok case)");
    let r8 , e8 = TestStructStrError(5);
    if e8 != nil {
        print("  Error text:", e8.text, ", context:", e8.context);
    } else {
        print("  Result:", r8);
    }

    print("Test 8b: StrError struct (Err case)");
    let r8b , e8b = TestStructStrError(-5);
    if e8b != nil {
        print("  Error text:", e8b.text, ", context:", e8b.context);
    } else {
        print("  Result:", r8b);
    }

    // Test 9: Array of Int
    print("\nTest 9: [Int] error (Ok case)");
    let r9 , e9 = TestArrayIntError(5);
    if e9 != nil {
        print("  Error array:", e9);
    } else {
        print("  Result:", r9);
    }

    print("Test 9b: [Int] error (Err case)");
    let r9b , e9b = TestArrayIntError(-5);
    if e9b != nil {
        print("  Error array:", e9b);
    } else {
        print("  Result:", r9b);
    }

    // Test 10: Array of Float
    print("\nTest 10: [Float] error (Ok case)");
    let r10 , e10 = TestArrayFloatError(5.5);
    if e10 != nil {
        print("  Error array:", e10);
    } else {
        print("  Result:", r10);
    }

    print("Test 10b: [Float] error (Err case)");
    let r10b , e10b = TestArrayFloatError(-5.5);
    if e10b != nil {
        print("  Error array:", e10b);
    } else {
        print("  Result:", r10b);
    }

    // Test 11: Array of Bool
    print("\nTest 11: [Bool] error (Ok case)");
    let r11 , e11 = TestArrayBoolError(false);
    if e11 != nil {
        print("  Error array:", e11);
    } else {
        print("  Result:", r11);
    }

    print("Test 11b: [Bool] error (Err case)");
    let r11b , e11b = TestArrayBoolError(true);
    if e11b != nil {
        print("  Error array:", e11b);
    } else {
        print("  Result:", r11b);
    }

    // Test 12: Array of Str
    print("\nTest 12: [Str] error (Ok case)");
    let r12 , e12 = TestArrayStrError(5);
    if e12 != nil {
        print("  Error array:", e12);
    } else {
        print("  Result:", r12);
    }

    print("Test 12b: [Str] error (Err case)");
    let r12b , e12b = TestArrayStrError(-5);
    if e12b != nil {
        print("  Error array:", e12b);
    } else {
        print("  Result:", r12b);
    }

    // Test 13-28: Map error types (abbreviated for brevity)
    print("\nTest 13: {Str: Int} error (Err case)");
    let r13 , e13 = TestMapStrIntError(-5);
    if e13 != nil {
        print("  Error map:", e13);
    } else {
        print("  Result:", r13);
    }

    print("\nTest 14: {Str: Float} error (Err case)");
    let r14 , e14 = TestMapStrFloatError(-5.5);
    if e14 != nil {
        print("  Error map:", e14);
    } else {
        print("  Result:", r14);
    }

    print("\nTest 15: {Str: Bool} error (Err case)");
    let r15 , e15 = TestMapStrBoolError(true);
    if e15 != nil {
        print("  Error map:", e15);
    } else {
        print("  Result:", r15);
    }

    print("\nTest 16: {Str: Str} error (Err case)");
    let r16 , e16 = TestMapStrStrError(-5);
    if e16 != nil {
        print("  Error map:", e16);
    } else {
        print("  Result:", r16);
    }

    print("\nTest 17: {Int: Int} error (Err case)");
    let r17 , e17 = TestMapIntIntError(-5);
    if e17 != nil {
        print("  Error map:", e17);
    } else {
        print("  Result:", r17);
    }

    print("\nTest 18: {Int: Float} error (Err case)");
    let r18 , e18 = TestMapIntFloatError(-5.5);
    if e18 != nil {
        print("  Error map:", e18);
    } else {
        print("  Result:", r18);
    }

    print("\nTest 19: {Int: Bool} error (Err case)");
    let r19 , e19 = TestMapIntBoolError(true);
    if e19 != nil {
        print("  Error map:", e19);
    } else {
        print("  Result:", r19);
    }

    print("\nTest 20: {Int: Str} error (Err case)");
    let r20 , e20 = TestMapIntStrError(-5);
    if e20 != nil {
        print("  Error map:", e20);
    } else {
        print("  Result:", r20);
    }

    print("\nTest 21: {Float: Int} error (Err case)");
    let r21 , e21 = TestMapFloatIntError(-5);
    if e21 != nil {
        print("  Error map:", e21);
    } else {
        print("  Result:", r21);
    }

    print("\nTest 22: {Float: Float} error (Err case)");
    let r22 , e22 = TestMapFloatFloatError(-5.5);
    if e22 != nil {
        print("  Error map:", e22);
    } else {
        print("  Result:", r22);
    }

    print("\nTest 23: {Float: Bool} error (Err case)");
    let r23 , e23 = TestMapFloatBoolError(true);
    if e23 != nil {
        print("  Error map:", e23);
    } else {
        print("  Result:", r23);
    }

    print("\nTest 24: {Float: Str} error (Err case)");
    let r24 , e24 = TestMapFloatStrError(-5);
    if e24 != nil {
        print("  Error map:", e24);
    } else {
        print("  Result:", r24);
    }

    print("\nTest 25: {Bool: Int} error (Err case)");
    let r25 , e25 = TestMapBoolIntError(-5);
    if e25 != nil {
        print("  Error map:", e25);
    } else {
        print("  Result:", r25);
    }

    print("\nTest 26: {Bool: Float} error (Err case)");
    let r26 , e26 = TestMapBoolFloatError(-5.5);
    if e26 != nil {
        print("  Error map:", e26);
    } else {
        print("  Result:", r26);
    }

    print("\nTest 27: {Bool: Bool} error (Err case)");
    let r27 , e27 = TestMapBoolBoolError(true);
    if e27 != nil {
        print("  Error map:", e27);
    } else {
        print("  Result:", r27);
    }

    print("\nTest 28: {Bool: Str} error (Err case)");
    let r28 , e28 = TestMapBoolStrError(-5);
    if e28 != nil {
        print("  Error map:", e28);
    } else {
        print("  Result:", r28);
    }

    print("\n=== All tests completed! ===");
}
