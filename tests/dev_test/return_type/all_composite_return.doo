struct Point { x: Int, y: Int }

enum Status { Active, Inactive, Pending }
enum Result { Success(Int), Failure(Str) }

struct Complex {
    arr: [Int],
    map: {Str: Int},
    status: Status,
}

fn returnPoint() -> Point {
    return Point { x: 10, y: 20 };
}

fn returnZeroPoint() -> Point {
    return Point { x: 0, y: 0 };
}

fn returnStatusActive() -> Status { return Status::Active; }
fn returnStatusInactive() -> Status { return Status::Inactive; }
fn returnResultSuccess() -> Result { return Result::Success(123); }
fn returnResultFailure() -> Result { return Result::Failure("fail"); }

fn returnComplex() -> Complex {
    return Complex { arr: [1,2], map: {"x": 2}, status: Status::Active };
}

fn returnEmptyComplex() -> Complex {
    return Complex { arr: [], map: {}, status: Status::Inactive };
}

fn main() {
    print("=== Struct Return Type Tests ===");
    let p = returnPoint();
    print("Returned struct:", p);

    let zp = returnZeroPoint();
    print("Returned zero struct:", zp);

    print("\n=== Enum Return Type Tests ===");
    print("Returned enum:", returnStatusActive());
    print("Returned enum:", returnStatusInactive());
    print("Returned enum with payload:", returnResultSuccess());
    print("Returned enum with payload:", returnResultFailure());

    print("\n=== Complex/Composite Return Type Tests ===");
    let c = returnComplex();
    print("Returned complex struct:", c);

    let ec = returnEmptyComplex();
    print("Returned empty complex struct:", ec);
}

// EXPECT: === Struct Return Type Tests ===
// EXPECT: Returned struct: Point { x: 10, y: 20 }
// EXPECT: Returned zero struct: Point { x: 0, y: 0 }
// EXPECT:
// EXPECT: === Enum Return Type Tests ===
// EXPECT: Returned enum: Active
// EXPECT: Returned enum: Inactive
// EXPECT: Returned enum with payload: Success(123)
// EXPECT: Returned enum with payload: Failure(fail)
// EXPECT:
// EXPECT: === Complex/Composite Return Type Tests ===
// EXPECT: Returned complex struct: Complex { arr: [1, 2], map: {"x": 2}, status: Active }
// EXPECT: Returned empty complex struct: Complex { arr: [], map: {}, status: Inactive }
