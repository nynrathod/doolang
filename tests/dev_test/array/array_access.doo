fn main() {
    // === Array Get with [] ===
    print("=== Array Get ===");

    // Int array
    let arr = [10, 20, 30, 40, 50];
    print("arr:", arr);
    print("arr[0]:", arr[0]);
    print("arr[2]:", arr[2]);
    print("arr[4]:", arr[4]);

    // Float array
    let floats = [1.5, 2.5, 3.5];
    print("\nfloats:", floats);
    print("floats[0]:", floats[0]);
    print("floats[1]:", floats[1]);

    // Bool array
    let flags = [true, false, true];
    print("\nflags:", flags);
    print("flags[0]:", flags[0]);
    print("flags[1]:", flags[1]);
    print("flags[2]:", flags[2]);

    // String array
    let names = ["Alice", "Bob", "Charlie"];
    print("\nnames:", names);
    print("names[0]:", names[0]);
    print("names[2]:", names[2]);

    // === Array Set with [] ===
    print("\n=== Array Set ===");

    // Int array set
    let mut nums = [1, 2, 3, 4, 5];
    print("nums before:", nums);
    nums[0] = 100;
    nums[2] = 300;
    nums[4] = 500;
    print("nums after:", nums);

    // Float array set
    let mut fvals = [1.1, 2.2, 3.3];
    print("\nfvals before:", fvals);
    fvals[1] = 9.9;
    print("fvals after:", fvals);

    // Bool array set
    let mut bools = [true, true, true];
    print("\nbools before:", bools);
    bools[1] = false;
    print("bools after:", bools);

    // === Out of Bounds (uncomment to test panic) ===
    // print(arr[10]);    // panic: index 10, length 5
    // nums[100] = 999;   // panic: index 100, length 5
}

// EXPECT: === Array Get ===
// EXPECT: arr: [10, 20, 30, 40, 50]
// EXPECT: arr[0]: 10
// EXPECT: arr[2]: 30
// EXPECT: arr[4]: 50
// EXPECT: floats: [1.5, 2.5, 3.5]
// EXPECT: floats[0]: 1.5
// EXPECT: floats[1]: 2.5
// EXPECT: flags: [true, false, true]
// EXPECT: flags[0]: true
// EXPECT: flags[1]: false
// EXPECT: flags[2]: true
// EXPECT: names: ["Alice", "Bob", "Charlie"]
// EXPECT: names[0]: Alice
// EXPECT: names[2]: Charlie
// EXPECT: === Array Set ===
// EXPECT: nums before: [1, 2, 3, 4, 5]
// EXPECT: nums after: [100, 2, 300, 4, 500]
// EXPECT: fvals before: [1.1, 2.2, 3.3]
// EXPECT: fvals after: [1.1, 9.9, 3.3]
// EXPECT: bools before: [true, true, true]
// EXPECT: bools after: [true, false, true]
