//
// types.doo - Module with public and private structs and enums
//

// Public struct (PascalCase) - can be imported
struct User {
    Name: Str,
    Email: Str,
    age: Int
}

// Private struct (camelCase) - cannot be imported
struct config {
    host: Str,
    port: Int
}

// Public enum (PascalCase) - can be imported
enum Status {
    Active,
    Inactive,
    Pending
}

// Private enum (camelCase) - cannot be imported
enum mode {
    Dev,
    Prod
}

// Public function that uses public struct
fn CreateUser(name: Str, email: Str) -> Int {
    print("Creating user:", name);
    Ok 1;
}

// Public function that uses public enum
fn GetActiveStatus() -> Int {
    print("Getting active status");
    Ok 1;
}

// Private function (camelCase) - cannot be imported
fn internalCheck() -> Int {
    return 42;
}
