//
// Comprehensive Closure Tests - all closure features
//

// fn(T) -> U as parameter
fn applyToAll(items: [Int], action: fn(Int) -> Int) -> [Int] {
    let mut result: [Int] = [];
    for item in items {
        result.push(action(item));
    }
    return result;
}

// fn() -> T (zero params)
fn callTwice(action: fn() -> Int) -> [Int] {
    return [action(), action()];
}

// fn with multiple params
fn combine(a: Int, b: Int, op: fn(Int, Int) -> Int) -> Int {
    return op(a, b);
}

fn main() {
    print("=== Comprehensive Closure Tests ===\n");

    // --- 1. Inline closure passed as fn(T)->U parameter ---
    let doubled = applyToAll([1, 2, 3], (x) => x * 2);
    print("1. applyToAll doubled:", doubled);

    // --- 2. Block body closure ---
    let squared = applyToAll([1, 2, 3], (x) => {
        let result = x * x;
        return result;
    });
    print("2. applyToAll squared:", squared);

    // --- 3. Zero-param closure (fn()->T) ---
    let counter = callTwice(() => 42);
    print("3. callTwice:", counter);

    // --- 4. Multi-param closure ---
    let sum = combine(10, 20, (a, b) => a + b);
    print("4. combine sum:", sum);

    let product = combine(5, 6, (a, b) => a * b);
    print("5. combine product:", product);

    // --- 6. Closure with variable capture (single) ---
    let multiplier = 10;
    let scaled = applyToAll([1, 2, 3], (x) => x * multiplier);
    print("6. capture single:", scaled);

    // --- 7. Closure with multiple captures ---
    let base = 100;
    let factor = 3;
    let computed = applyToAll([1, 2], (x) => base + x * factor);
    print("7. capture multiple:", computed);

    // --- 8. Capture with block body ---
    let offset = 50;
    let adjusted = applyToAll([1, 2, 3], (x) => {
        let tmp = x + offset;
        return tmp * 2;
    });
    print("8. capture block:", adjusted);

    // --- 9. Closure with default param type (Int inferred) ---
    let addOne = (x) => x + 1;
    let result9 = addOne(99);
    print("9. standalone closure:", result9);

    // --- 10. Chain: filter -> map using closures passed as args ---
    let chained = applyToAll([1, 2, 3, 4, 5], (x) => x + 1);
    print("10. chain prep:", chained);

    print("\n=== All Closure Tests Complete ===");
}

// EXPECT: === Comprehensive Closure Tests ===
// EXPECT: 1. applyToAll doubled: [2, 4, 6]
// EXPECT: 2. applyToAll squared: [1, 4, 9]
// EXPECT: 3. callTwice: [42, 42]
// EXPECT: 4. combine sum: 30
// EXPECT: 5. combine product: 30
// EXPECT: 6. capture single: [10, 20, 30]
// EXPECT: 7. capture multiple: [103, 106]
// EXPECT: 8. capture block: [102, 104, 106]
// EXPECT: 9. standalone closure: 100
// EXPECT: 10. chain prep: [2, 3, 4, 5, 6]
// EXPECT: === All Closure Tests Complete ===
