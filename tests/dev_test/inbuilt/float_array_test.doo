// Test float operations in loop

fn main() {
    print("=== Float Loop Test ===");

    let floats: [Float] = [1.0, 2.0, 3.0];
    print("Array:", floats);

    // Simple loop without index
    let mut sum: Float = 0.0;
    for val in floats {
        print("  Value:", val);
        sum = sum + val;
        print("  Sum so far:", sum);
    }
    print("Final sum:", sum);

    print("=== Test Complete ===");
}
