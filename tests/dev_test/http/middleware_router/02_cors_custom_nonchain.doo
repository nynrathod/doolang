import std::Http::{Server};

fn Ping() -> Str {
    return "Ok";
}

fn main() {
    let app = Server.new(":3112");

    app.cors({
        origins: ["https://allowed.com"],
        methods: ["GET"],
        headers: ["Content-Type"],
        credentials: true,
    });

    app.get("/ping", Ping);

    app.start();
}
