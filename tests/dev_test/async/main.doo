// =============================================================================
// DOO ASYNC & CONCURRENCY — COMPREHENSIVE TEST
// =============================================================================
// Tests all async primitives: sleep, go, scope, async fn, await, for+sleep
// Verifies REAL concurrency via task ordering (shorter tasks finish first)
// =============================================================================
import helpers::{SlowQuery, BackgroundWorker, Compute};

// --- Async function declarations ---

async fn fetchUser() -> Str {
    sleep(40);
    return "Alice";
}

async fn fetchEmail() -> Str {
    sleep(20);
    return "alice@doo.dev";
}

async fn fetchRole() -> Str {
    sleep(60);
    return "admin";
}

fn main() {
    print("========================================");
    print("  DOO ASYNC FULL VERIFICATION SUITE");
    print("========================================");
    print("");

    // =========================================================================
    // TEST 1: sleep() blocks correctly
    // =========================================================================
    print("TEST 1: sleep() blocking");
    print("  before sleep");
    sleep(50);
    print("  after sleep (50ms)");
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 2: await sleep() — same as sleep, await is pass-through on calls
    // =========================================================================
    print("TEST 2: await sleep()");
    await sleep(50);
    print("  slept 50ms via await");
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 3: async fn + await — call async fn, get return value
    // =========================================================================
    print("TEST 3: async fn + await returns value");
    let user = await fetchUser();
    print("  user = ${user}");
    let email = await fetchEmail();
    print("  email = ${email}");
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 4: go { } — fire and forget (detached)
    // =========================================================================
    print("TEST 4: go fire-and-forget");
    go {
        print("  detached task running");
    }
    sleep(100);
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 5: let task = go { } — awaitable handle
    // =========================================================================
    print("TEST 5: let task = go {}");
    let task = go {
        sleep(30);
        print("  task with handle done");
    };
    sleep(100);
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 6: CONCURRENCY PROOF — scope with ordering verification
    // If concurrent: B(20ms) finishes before A(60ms)
    // If sequential: A always finishes before B
    // =========================================================================
    print("TEST 6: Concurrency proof (scope ordering)");
    print("  Launching A(60ms) and B(20ms) concurrently...");
    scope {
        go {
            sleep(60);
            print("  A done (60ms)");
        }
        go {
            sleep(20);
            print("  B done (20ms)");
        }
    }
    print("  If B printed before A → real concurrency");
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 7: scope waits for ALL tasks (structured concurrency)
    // =========================================================================
    print("TEST 7: scope waits for all tasks");
    scope {
        go {
            sleep(40);
            print("  slow task done");
        }
        go {
            sleep(10);
            print("  fast task done");
        }
        go {
            print("  instant task done");
        }
    }
    print("  scope exited — all 3 tasks finished");
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 8: async fn called from inside go block
    // =========================================================================
    print("TEST 8: async fn inside go");
    go {
        let r = await SlowQuery("db1", 30);
        print("  go+async result: ${r}");
    }
    sleep(200);
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 9: scope with imported async fn calls (cross-file)
    // =========================================================================
    print("TEST 9: scope + imported async fn");
    scope {
        go {
            let r1 = await SlowQuery("users", 40);
            print("  ${r1}");
        }
        go {
            let r2 = await SlowQuery("posts", 20);
            print("  ${r2}");
        }
    }
    print("  scope with imported async fns done");
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 10: 3 concurrent scope tasks — ordering proves parallelism
    // C(10ms) < B(30ms) < A(50ms)
    // =========================================================================
    print("TEST 10: 3-way concurrency proof");
    scope {
        go {
            sleep(50);
            print("  A done (50ms)");
        }
        go {
            sleep(30);
            print("  B done (30ms)");
        }
        go {
            sleep(10);
            print("  C done (10ms)");
        }
    }
    print("  Expected order: C, B, A");
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 11: Nested go blocks
    // =========================================================================
    print("TEST 11: Nested go blocks");
    go {
        print("  outer go start");
        go {
            sleep(10);
            print("  inner go done");
        }
        sleep(40);
        print("  outer go done");
    }
    sleep(200);
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 12: Sequential await on multiple async fn
    // =========================================================================
    print("TEST 12: Sequential await chain");
    let u = await fetchUser();
    let e = await fetchEmail();
    let r = await fetchRole();
    print("  ${u} / ${e} / ${r}");
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 13: for loop with sleep (polling pattern)
    // =========================================================================
    print("TEST 13: for loop with await sleep");
    for i in 0..3 {
        await sleep(20);
        print("  poll iteration ${i}");
    }
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 14: Mixed sync/async — compute + sleep interleaved
    // =========================================================================
    print("TEST 14: Mixed sync (compute) + async (sleep)");
    let v1 = Compute(5);
    print("  compute(5) = ${v1}");
    await sleep(20);
    let v2 = Compute(10);
    print("  compute(10) = ${v2}");
    await sleep(20);
    print("  sync+async interleave works");
    print("  PASS");
    print("");

    // =========================================================================
    // TEST 15: scope with backgroundWorker (imported, multi-tick)
    // =========================================================================
    print("TEST 15: scope with background workers");
    scope {
        go {
            let w1 = await BackgroundWorker("W1", 2);
            print("  ${w1}");
        }
        go {
            let w2 = await BackgroundWorker("W2", 3);
            print("  ${w2}");
        }
    }
    print("  both workers completed");
    print("  PASS");
    print("");

    print("========================================");
    print("  ALL 15 TESTS PASSED");
    print("========================================");
}
