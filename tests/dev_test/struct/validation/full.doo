// Comprehensive decorator validation test
// Tests all supported decorators with valid usage

// @email
// @min
// @max
// @enum

enum UserRole {
    Admin,
    User,
    Guest,
}

struct User {
    Email: Str @email,
    Username: Str @min(3) @max(20),
    Password: Str @min(8) @max(100),
    Role: UserRole,
    Age: Int @min(0) @max(150),
}

fn main() {
    print("Testing comprehensive decorator validation...");

    let user = User {
        Email: "john@example.com",
        Username: "john_doe",
        Password: "securepass123",
        Role: UserRole::User,
        Age: 30,
    };

    print("User created successfully!");
    print("Email:", user.Email);
    print("Username:", user.Username);
    print("Role:", user.Role);

    print("All decorator validation tests passed!");
}
