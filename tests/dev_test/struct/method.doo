===== BASIC STRUCT =====
struct User {
    age: Int,
    name: Str
}

fn User.isAdult(self) -> Bool {
    return self.age >= 18;
}

fn User.getAge(self) -> Int {
    return self.age;
}

fn User.getName(self) -> Str {
    return self.name;
}

fn User.greet(self) -> Str {
    return "Hello, " + self.name;
}

fn User.incrementAge(self) -> Int {
    return self.age + 1;
}

// ===== STRUCT WITH MULTIPLE FIELDS =====
struct Point {
    x: Int,
    y: Int
}

fn Point.distance(self) -> Float {
    let xSquared = self.x * self.x;
    let ySquared = self.y * self.y;
    let sum = xSquared + ySquared;
    return (sum as Float);
}

fn Point.getX(self) -> Int {
    return self.x;
}

fn Point.getY(self) -> Int {
    return self.y;
}

// ===== STRUCT WITH DIFFERENT TYPES =====
struct Product {
    name: Str,
    price: Float,
    inStock: Bool,
    quantity: Int
}

fn Product.isAvailable(self) -> Bool {
    return self.inStock;
}

fn Product.getTotalValue(self) -> Float {
    return self.price * (self.quantity as Float);
}

fn Product.getName(self) -> Str {
    return self.name;
}

fn Product.getPrice(self) -> Float {
    return self.price;
}

// ===== NESTED STRUCT =====
struct Address {
    street: Str,
    city: Str
}

struct Person {
    name: Str,
    age: Int,
    address: Address
}

fn Address.getFullAddress(self) -> Str {
    return self.street + ", " + self.city;
}

fn Person.getName(self) -> Str {
    return self.name;
}

fn Person.getAge(self) -> Int {
    return self.age;
}

fn Person.getCity(self) -> Str {
    return self.address.city;
}

// ===== MAIN FUNCTION =====
fn main() {
    print("===== USER STRUCT =====");
    let user = User { age: 25, name: "Alice" };
    print(user.isAdult());
    print(user.getAge());
    print(user.getName());
    print(user.greet());
    print(user.incrementAge());

    print("===== POINT STRUCT =====");
    let point = Point { x: 3, y: 4 };
    print(point.getX());
    print(point.getY());
    print(point.distance());

    print("===== PRODUCT STRUCT =====");
    let product = Product { name: "Laptop", price: 999.99, inStock: true, quantity: 5 };
    print(product.isAvailable());
    print(product.getTotalValue());
    print(product.getName());
    print(product.getPrice());

    print("===== NESTED STRUCT =====");
    let addr = Address { street: "123 Main St", city: "New York" };
    print(addr.getFullAddress());

    let person = Person { name: "Bob", age: 30, address: addr };
    print(person.getName());
    print(person.getAge());
    print(person.getCity());
}

//
// EXPECT: ===== USER STRUCT =====
// EXPECT: true
// EXPECT: 25
// EXPECT: Alice
// EXPECT: Hello, Alice
// EXPECT: 26
// EXPECT: ===== POINT STRUCT =====
// EXPECT: 3
// EXPECT: 4
// EXPECT: 5
// EXPECT: ===== PRODUCT STRUCT =====
// EXPECT: true
// EXPECT: 4999.95
// EXPECT: Laptop
// EXPECT: 999.99
// EXPECT: ===== NESTED STRUCT =====
