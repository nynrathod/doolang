// OUTPUT: Sum 1-10: 55
// OUTPUT: Sum 11-20: 155
// OUTPUT: Total: 210
fn main() {
    let a = 1;
    let b = 2;
    let c = 3;
    let d = 4;
    let e = 5;
    let f = 6;
    let g = 7;
    let h = 8;
    let i = 9;
    let j = 10;
    let k = 11;
    let l = 12;
    let m = 13;
    let n = 14;
    let o = 15;
    let p = 16;
    let q = 17;
    let r = 18;
    let s = 19;
    let t = 20;
    let sum = a + b + c + d + e + f + g + h + i + j;
    let sum2 = k + l + m + n + o + p + q + r + s + t;
    print("Sum 1-10:", sum);
    print("Sum 11-20:", sum2);
    print("Total:", sum + sum2);
}

