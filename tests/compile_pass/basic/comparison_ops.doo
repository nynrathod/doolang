// OUTPUT: a == b: false
// OUTPUT: a == c: true
// OUTPUT: a != b: true
// OUTPUT: a != c: false
// OUTPUT: a < b: true
// OUTPUT: b < a: false
// OUTPUT: a > b: false
// OUTPUT: b > a: true
// OUTPUT: a <= c: true
// OUTPUT: a <= b: true
// OUTPUT: a >= c: true
// OUTPUT: b >= a: true
// OUTPUT: x == z: true
// OUTPUT: x != y: true
// OUTPUT: x < y: true
// OUTPUT: y > x: true
// OUTPUT: x <= z: true
// OUTPUT: y >= x: true
// OUTPUT: s1 == s3: true
// OUTPUT: s1 != s2: true
// OUTPUT: true == true: true
// OUTPUT: true != false: true
fn main() {
    let a: Int = 10;
    let b: Int = 20;
    let c: Int = 10;

    print("a == b:", a == b);
    print("a == c:", a == c);
    print("a != b:", a != b);
    print("a != c:", a != c);
    print("a < b:", a < b);
    print("b < a:", b < a);
    print("a > b:", a > b);
    print("b > a:", b > a);
    print("a <= c:", a <= c);
    print("a <= b:", a <= b);
    print("a >= c:", a >= c);
    print("b >= a:", b >= a);

    let x: Float = 1.5;
    let y: Float = 2.5;
    let z: Float = 1.5;
    print("x == z:", x == z);
    print("x != y:", x != y);
    print("x < y:", x < y);
    print("y > x:", y > x);
    print("x <= z:", x <= z);
    print("y >= x:", y >= x);

    let s1 = "abc";
    let s2 = "def";
    let s3 = "abc";
    print("s1 == s3:", s1 == s3);
    print("s1 != s2:", s1 != s2);

    print("true == true:", true == true);
    print("true != false:", true != false);
}

