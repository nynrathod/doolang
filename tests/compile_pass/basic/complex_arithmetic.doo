// OUTPUT: (a+b)*c: 45
// OUTPUT: a+(b*c): 25
// OUTPUT: (a-b)*(a+b): 75
// OUTPUT: ((a+b)*c)/(a-b): 9
// OUTPUT: a*b+c*a-b: 75
// OUTPUT: (a+b+c)*(a-b-c): 36
// OUTPUT: a%c+b%c: 3
// OUTPUT: a^2+b^2: 125
// OUTPUT: Float nested: 7.000000 15.000000
fn main() {
    let a = 10;
    let b = 5;
    let c = 3;

    let r1 = (a + b) * c;
    let r2 = a + (b * c);
    let r3 = (a - b) * (a + b);
    let r4 = ((a + b) * c) / (a - b);
    let r5 = a * b + c * a - b;
    let r6 = (a + b + c) * (a - b - c);
    let r7 = a % c + b % c;
    let r8 = (a * a) + (b * b);

    print("(a+b)*c:", r1);
    print("a+(b*c):", r2);
    print("(a-b)*(a+b):", r3);
    print("((a+b)*c)/(a-b):", r4);
    print("a*b+c*a-b:", r5);
    print("(a+b+c)*(a-b-c):", r6);
    print("a%c+b%c:", r7);
    print("a^2+b^2:", r8);

    let f1 = 2.0 * 3.0 + 1.0;
    let f2 = (2.0 + 3.0) * (4.0 - 1.0);
    print("Float nested:", f1, f2);
}

