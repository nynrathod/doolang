// OUTPUT: Sum: 15
// OUTPUT: Product: 120
// OUTPUT: Evens: [2, 4]
// OUTPUT: Odds: [1, 3, 5]
fn main() {
    let nums = [1, 2, 3, 4, 5];

    let sum = nums.reduce(0, (a, b) => a + b);
    print("Sum:", sum);

    let product = nums.reduce(1, (a, b) => a * b);
    print("Product:", product);

    let evens = nums.filter((x) => x % 2 == 0);
    print("Evens:", evens);

    let odds = nums.filter((x) => x % 2 == 1);
    print("Odds:", odds);
}
