// Auth module for Doo
// Supports JWT-based authentication with bcrypt password hashing
//
// Usage:
//   import std::Auth;
//
//   fn main() {
//       let app = Server::new(":3000");
//       app.get("/profile", Jwt(), ProfileHandler);
//   }
//
// Or with auth/crud:
//   app.auth("/signup", "/login", User, db);
//   app.crud("/products", Product, db);

// === Structs ===

// JWT Claims
struct JwtClaims {
    Sub: Str,      // Subject (user ID)
    Exp: Int,      // Expiration timestamp
    Iat: Int,      // Issued at timestamp
    Data: Str,     // Custom data (JSON string)
}

// Auth error struct
struct AuthError {
    Code: Int,
    Message: Str,
}

// === Password Hashing Functions ===

// Hash a password using bcrypt
@extern("doo_auth", "doo_auth_hash_password")
fn hashPassword(password: Str) -> Str !AuthError {}

// Verify a password against a hash
@extern("doo_auth", "doo_auth_verify_password")
fn verifyPassword(password: Str, hashed: Str) -> Bool !AuthError {}

// === JWT Functions ===

// Sign a JWT token
// Automatically reads JWT_SECRET from environment
// expiresSeconds: token validity duration (e.g., 3600 for 1 hour)
@extern("doo_auth", "doo_auth_sign")
fn signJwt(sub: Str, dataJson: Str, expiresSeconds: Int) -> Str !AuthError {}

// Verify and decode a JWT token
// Returns JSON string with claims
@extern("doo_auth", "doo_auth_verify")
fn verifyJwt(token: Str) -> Str !AuthError {}

// === Helper Functions ===

// Free auth result
@extern("doo_auth", "doo_auth_free_result")
fn freeAuthResult(ptr: Ptr) {}

// Free string from auth
@extern("doo_auth", "doo_auth_free_string")
fn freeAuthString(ptr: Ptr) {}

// === JWT Middleware ===

// JWT middleware function for route protection
// Usage: import Auth::Jwt; app.get("/profile", Jwt(), handler)
@extern("doo_http", "doo_http_jwt")
fn Jwt() -> Str {}
