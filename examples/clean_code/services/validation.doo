import models::user::{User};
import models::role::{Role};
import models::address::{Address};
import models::status::{AccountStatus};

struct ValidationError {
    Field: Str,
    Message: Str,
}

fn ValidateEmail(email: Str) -> Bool ! ValidationError {
    if email.trim() == "" {
        Err ValidationError { Field: "Email", Message: "Cannot be empty" };
    }
    if email.indexOf("@") == -1 {
        Err ValidationError { Field: "Email", Message: "Invalid email format" };
    }
    Ok true;
}

fn ValidateAge(age: Int) -> Bool ! ValidationError {
    if age < 0 {
        Err ValidationError { Field: "Age", Message: "Cannot be negative" };
    }
    if age > 150 {
        Err ValidationError { Field: "Age", Message: "Unrealistic value" };
    }
    Ok true;
}

fn ValidateName(name: Str) -> Bool ! ValidationError {
    if name.trim() == "" {
        Err ValidationError { Field: "Name", Message: "Cannot be empty" };
    }
    Ok true;
}

fn CreateUser(
    id: Int,
    name: Str,
    email: Str,
    age: Int,
    role: Role,
    address: Address
) -> User ! ValidationError {

    ValidateName(name)?;
    ValidateEmail(email)?;
    ValidateAge(age)?;

    Ok User {
        Id: id,
        Name: name,
        Email: email,
        Age: age,
        Role: role,
        Status: AccountStatus::Pending,
        Address: address,
    };
}
